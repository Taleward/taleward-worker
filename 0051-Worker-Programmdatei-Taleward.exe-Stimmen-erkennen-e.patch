--- a/taleward_worker/autostart.py
+++ b/taleward_worker/autostart.py
@@ -39,4 +39,31 @@ def aktiv() -> bool:
 
 
+def eintrag() -> str | None:
+    """Der gespeicherte Startbefehl (nur Windows), None ohne Eintrag."""
+    if sys.platform != "win32":
+        return None
+    import winreg
+
+    try:
+        with winreg.OpenKey(winreg.HKEY_CURRENT_USER, SCHLUESSEL) as k:
+            return str(winreg.QueryValueEx(k, NAME)[0])
+    except OSError:
+        return None
+
+
+def nachfuehren() -> bool:
+    """Zeigt ein vorhandener Eintrag auf ein anderes Programm (z. B. TalewardWorker.exe vor der Umbenennung in
+    Taleward.exe), auf das laufende umschreiben. Ohne Eintrag bleibt es aus. True, wenn umgeschrieben."""
+    if sys.platform != "win32" or not getattr(sys, "frozen", False):
+        return False
+    import subprocess
+
+    alt = eintrag()
+    if alt is None or alt == subprocess.list2cmdline(befehl()):
+        return False
+    setzen(True)
+    return True
+
+
 def setzen(an: bool) -> None:
     if sys.platform == "win32":
diff --git a/taleward_worker/fenster.py b/taleward_worker/fenster.py
index 88fb7e8..6e3bd7b 100644
--- a/taleward_worker/fenster.py
+++ b/taleward_worker/fenster.py
@@ -111,5 +111,30 @@ class KeineBruecke:
 
 
-LEER = '<!doctype html><meta charset="utf-8"><title>Taleward</title><body style="background:#F2E8D5"></body>'
+# Seitenfarbe aus den Marken-Tokens: Pergament hell, dunkles Thema „--paper“ – sonst blitzt das Fenster im dunklen
+# Windows beim Start hell auf
+PAPIER_HELL, PAPIER_DUNKEL = "#F2E8D5", "#121D22"
+
+
+def dunkel() -> bool:
+    """Windows im dunklen Thema für Apps? (Andere Systeme und Fehler: hell.)"""
+    if sys.platform != "win32":
+        return False
+    try:
+        import winreg
+
+        with winreg.OpenKey(winreg.HKEY_CURRENT_USER,
+                            r"Software\Microsoft\Windows\CurrentVersion\Themes\Personalize") as k:
+            return winreg.QueryValueEx(k, "AppsUseLightTheme")[0] == 0
+    except OSError:
+        return False
+
+
+def papier() -> str:
+    return PAPIER_DUNKEL if dunkel() else PAPIER_HELL
+
+
+def leer() -> str:
+    return ('<!doctype html><meta charset="utf-8"><title>Taleward</title>'
+            f'<body style="background:{papier()}"></body>')
 
 
