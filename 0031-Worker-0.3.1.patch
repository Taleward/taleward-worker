+    d.stoppen()
+    monkeypatch.setenv("ERSATZ_APP", "1")
+    d.starten()
+    assert d.warten_bis_bereit(15) and d.app_bereit.wait(5)
+    assert d.fuer_oberflaeche()["app"]
+    d.stoppen()
+    assert not d.app_bereit.is_set()
