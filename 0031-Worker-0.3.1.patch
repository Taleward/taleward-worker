 taleward_worker/__init__.py    |  2 +-
 taleward_worker/einzelplatz.py | 34 +++++++++++++++++++++++++--
 taleward_worker/oberflaeche.py | 43 ++++++++++++++++++++--------------
 taleward_worker/ui/app.js      | 12 ++++++----
 taleward_worker/ui/texte.js    | 34 +++++++++++++++------------
 tests/test_einzelplatz.py      | 27 ++++++++++++++++++++-
 uv.lock                        |  2 +-
 8 files changed, 114 insertions(+), 42 deletions(-)

