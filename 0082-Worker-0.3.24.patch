Date: Wed, 21 Oct 2026 23:43:40 +0200
Subject: [PATCH] Worker 0.3.24

Pakete aktualisiert (certifi 2026.10.19, Pillow 13.0.0). Messwerte des letzten Auftrags ohne Steuerzeichen
und ohne riesige oder unendliche Zahlen.
---
 pyproject.toml              |  2 +-
 taleward_worker/__init__.py |  2 +-
 taleward_worker/dienst.py   | 31 ++++++++++---
 tests/test_worker_0324.py   | 18 ++++++++
 uv.lock                     | 91 +++++++++++++++++++------------------
 5 files changed, 92 insertions(+), 52 deletions(-)
 create mode 100644 tests/test_worker_0324.py

diff --git a/pyproject.toml b/pyproject.toml
index 3fb9c2f..b2c5f3b 100644
--- a/pyproject.toml
+++ b/pyproject.toml
@@ -1,5 +1,5 @@
 [project]
 name = "taleward-worker"
-version = "0.3.23"
+version = "0.3.24"
 description = "Taleward Worker – verarbeitet Aufnahmen für einen Taleward-Server auf dem eigenen PC mit Grafikkarte"
 license = "AGPL-3.0-only"
diff --git a/taleward_worker/__init__.py b/taleward_worker/__init__.py
index b320dc4..3e1234e 100644
--- a/taleward_worker/__init__.py
+++ b/taleward_worker/__init__.py
@@ -4,5 +4,5 @@ Die App selbst ist klein. Das KI-Paket (Taleward-Server mit WhisperX, einige GB)
 passender Fassung zum verbundenen Server und startet es als Unterprozess („chronik worker --app“).
 """
-VERSION = "0.3.23"
+VERSION = "0.3.24"
 REPO = "Taleward/taleward-server"        # Server-Code = KI-Paket (engine-requirements.txt, Tags v…)
 APP_REPO = "Taleward/taleward-worker"   # diese App
diff --git a/taleward_worker/dienst.py b/taleward_worker/dienst.py
index 46e1305..da51b57 100644
--- a/taleward_worker/dienst.py
+++ b/taleward_worker/dienst.py
@@ -7,4 +7,5 @@ from __future__ import annotations
 
 import json
+import math
 import os
 import re
@@ -121,4 +122,20 @@ MESS_STUFEN = ("einlesen", "erkennung", "ausrichtung", "sprechertrennung", "ausw
 
 
+def _messzahl(v) -> bool:
+    """Endliche Zahl 0 ≤ v < 1e7 (auch riesige Ganzzahlen und inf/nan sicher abweisen)."""
+    if not isinstance(v, (int, float)) or isinstance(v, bool):
+        return False
+    try:
+        f = float(v)
+    except OverflowError:
+        return False
+    return math.isfinite(f) and 0 <= f < 1e7
+
+
+# Steuer- und Richtungszeichen: würden sonst Zusatzzeilen ins Protokoll (und die Hilfe-Datei) schreiben
+_UNSICHTBAR = re.compile("[" + "".join(f"{chr(a)}-{chr(b)}" for a, b in (
+    (0x00, 0x1F), (0x7F, 0x9F), (0x61C, 0x61C), (0x200E, 0x200F), (0x202A, 0x202E), (0x2066, 0x2069))) + "]")
+
+
 def messwerte_bereinigen(m) -> dict:
     """Messwerte des letzten Auftrags (vom KI-Paket): nur bekannte Felder mit einfachen Werten."""
@@ -127,11 +144,12 @@ def messwerte_bereinigen(m) -> dict:
     aus: dict = {}
     for k in MESS_ZAHLEN:
-        v = m.get(k)
-        if isinstance(v, (int, float)) and not isinstance(v, bool) and 0 <= v < 1e7:
-            aus[k] = round(float(v), 1)
+        if _messzahl(m.get(k)):
+            aus[k] = round(float(m[k]), 1)
     for k in MESS_TEXTE:
         v = m.get(k)
-        if isinstance(v, str) and v.strip():
-            aus[k] = v.strip()[:80]
+        if isinstance(v, str):
+            v = " ".join(_UNSICHTBAR.sub(" ", v).split())[:80]
+            if v:
+                aus[k] = v
     for k in ("ganzAufKarte", "abgestuft"):
         if isinstance(m.get(k), bool):
@@ -139,6 +157,5 @@ def messwerte_bereinigen(m) -> dict:
     stufen = m.get("stufen")
     if isinstance(stufen, dict):
-        s = {k: round(float(stufen[k]), 1) for k in MESS_STUFEN
-             if isinstance(stufen.get(k), (int, float)) and not isinstance(stufen.get(k), bool) and stufen[k] >= 0}
+        s = {k: round(float(stufen[k]), 1) for k in MESS_STUFEN if _messzahl(stufen.get(k))}
         if s:
             aus["stufen"] = s
diff --git a/tests/test_worker_0324.py b/tests/test_worker_0324.py
new file mode 100644
index 0000000..c24d075
--- /dev/null
+++ b/tests/test_worker_0324.py
@@ -0,0 +1,18 @@
+"""Worker 0.3.24: Messwerte ohne Steuerzeichen und ohne riesige oder unendliche Zahlen; certifi und Pillow aktuell."""
+from taleward_worker.dienst import messwerte_bereinigen
+
+
+def test_messwerte_bereinigt():
+    m = messwerte_bereinigen({"einlesenTokS": 10 ** 400, "schreibenTokS": float("inf"), "kontext": 32768,
+                              "modell": "gemma" + chr(10) + "Fremde Zeile" + chr(0x202E),
+                              "stufen": {"erkennung": float("inf"), "einlesen": 3, "ausrichtung": 10 ** 400}})
+    assert "einlesenTokS" not in m and "schreibenTokS" not in m and m["kontext"] == 32768.0
+    assert chr(10) not in m["modell"] and chr(0x202E) not in m["modell"] and m["modell"] == "gemma Fremde Zeile"
+    assert m["stufen"] == {"einlesen": 3.0}
+
+
+def test_pakete_aktuell():
+    from pathlib import Path
+
+    lock = (Path(__file__).resolve().parent.parent / "uv.lock").read_text(encoding="utf-8")
+    assert 'name = "certifi"\nversion = "2026.10.19"' in lock and 'name = "pillow"\nversion = "13.0.0"' in lock
