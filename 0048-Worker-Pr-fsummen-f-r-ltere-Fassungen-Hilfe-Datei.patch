@@ -359,8 +359,10 @@ class Installation:
             raise MotorFehler("installation", f"Für die Fassung {fassung or self.fassung} fehlt die unterschriebene "
                                               "Liste der PyTorch-Prüfsummen – sie wird nicht installiert.")
