         else:
             pytorch = pytorch_mit_pruefsummen(pytorch, liste, "cpu" if self.backend == "cpu" else TORCH_BACKEND)
@@ -713,4 +715,17 @@ PYTORCH_LISTE = "pytorch-pruefsummen.txt"
 PYTORCH_LISTE_PFLICHT_AB = "0.4.103"
 MAX_PYTORCH_LISTE = 256 * 1024
+# Für Fassungen ohne eigene Liste (bis 0.4.102, alle mit torch 2.8.0): die unterschriebene Liste der Freigabe v0.4.103
+# (pytorch-pruefsummen.txt, SHA-256 463f1c6d74a2921d039474612d284aa84058b332e8b7549b78b5d9c06ace098a), fest eingebaut.
+# Passt eine ältere Fassung nicht dazu, wird PyTorch nicht installiert.
+EINGEBAUTE_PYTORCH_LISTE = """\
+cu128 torch==2.8.0+cu128 --hash=sha256:039b9dcdd6bdbaa10a8a5cd6be22c4cb3e3589a341e5f904cbb571ca28f55bed --hash=sha256:34c55443aafd31046a7963b63d30bc3b628ee4a704f826796c865fdfd05bb596
+cu128 torchaudio==2.8.0+cu128 --hash=sha256:7a1eb6154e05b8056b34c7a41495e09d57f79eb0180eb4e7f3bb2a61845ca8ea --hash=sha256:f4409df567d0723a7a3a89d32c7552a17e0ff6f137ea26a0d268c665259b2995
+cu128 torchvision==0.23.0+cu128 --hash=sha256:70b3d8bfe04438006ec880c162b0e3aaac90c48b759aa41638dd714c732b182c --hash=sha256:93f1b5f56b20cd6869bca40943de4fd3ca9ccc56e1b57f47c671de1cdab39cdb
+cpu torch==2.8.0+cpu --hash=sha256:2bfc013dd6efdc8f8223a0241d3529af9f315dffefb53ffa3bf14d3f10127da6 --hash=sha256:41e6fc5ec0914fcdce44ccf338b1d19a441b55cafdd741fd0bf1af3f9e4cfd14 --hash=sha256:680129efdeeec3db5da3f88ee5d28c1b1e103b774aef40f9d638e2cce8f8d8d8 --hash=sha256:7631ef49fbd38d382909525b83696dc12a55d68492ade4ace3883c62b9fc140f --hash=sha256:cb06175284673a581dd91fb1965662ae4ecaba6e5c357aa0ea7bb8b84b6b7eeb
+cpu torchaudio==2.8.0 --hash=sha256:4573c6042950c20278e3608a9a38050ba0bc72e0049e1bbfd249caf859a8029b --hash=sha256:c9276857d241c6de257af765c0f51fc011af38cb725401495121b280913007cf
+cpu torchaudio==2.8.0+cpu --hash=sha256:db37df7eee906f8fe0a639fdc673f3541cb2e173169b16d4133447eb922d1938 --hash=sha256:e54bd7fc9472019308097d99102df9acee22aa2451ae808d27840bc874320292
+cpu torchvision==0.23.0 --hash=sha256:01dc33ee24c79148aee7cdbcf34ae8a3c9da1674a591e781577b716d233b1fa6 --hash=sha256:49aa20e21f0c2bd458c71d7b449776cbd5f16693dd5807195a820612b8a229b7
+cpu torchvision==0.23.0+cpu --hash=sha256:51603eb071d0681abc4db98b10ff394ace31f425852e8de249b91c09c60eb19a --hash=sha256:d83d8075db43b8ca89680bdeb2f100c832e2a3aa61ee42c038b1a146e5e511b6
+"""
 _PYTORCH_ZEILE = re.compile(r"^([a-z0-9]+) ([a-z0-9_.-]+)==([A-Za-z0-9.+!]+)((?: --hash=sha256:[0-9a-f]{64})+)$")
 
diff --git a/tests/test_mitnehmen.py b/tests/test_mitnehmen.py
index ea6dc54..76a7185 100644
--- a/tests/test_mitnehmen.py
+++ b/tests/test_mitnehmen.py
@@ -167,2 +167,11 @@ def test_schwaerzen_cookies_sitzungen_und_vorsilben():
     for bleibt in ("Autor: Rabenfels", "Sitzungsdauer 3 h", "Fassung 0.3.7", "https://taleward.org/hilfe"):
         assert mitnehmen.schwaerzen(bleibt) == bleibt, bleibt
+
+
+def test_schwaerzen_token_ohne_kopfzeile():
+    from taleward_worker import mitnehmen
+
+    assert "abcdef1234567" not in mitnehmen.schwaerzen("Token abcdef1234567")
+    assert "abcdef1234567" not in mitnehmen.schwaerzen("auth failed: token abcdef1234567 expired")
+    for bleibt in ("Token wurde erneuert", "Token abgelaufen, neuer Versuch"):
+        assert mitnehmen.schwaerzen(bleibt) == bleibt, bleibt
diff --git a/tests/test_pruefsummen.py b/tests/test_pruefsummen.py
index c5a1ec8..32e7d18 100644
--- a/tests/test_pruefsummen.py
+++ b/tests/test_pruefsummen.py
@@ -86,6 +86,7 @@ def test_ki_paket_mit_pruefsummen(monkeypatch):
     assert "six==1.17.0" in l1 and "torch" not in l1
     assert "imageio-ffmpeg==0.6.0" in l1 and l1.count("--hash=") == 8  # fehlte in uv.lock → feste Fassung
-    assert a2[a2.index("--torch-backend") + 1] == "cu128" and l2.strip() == "torch==2.8.0" and "--no-deps" in a2
-    assert "--require-hashes" not in a2  # Fassung ohne Liste am Release: wie bisher
+    assert a2[a2.index("--torch-backend") + 1] == "cu128" and "--no-deps" in a2
+    # Fassung ohne Liste am Release: Prüfsummen aus der eingebauten Liste (torch 2.8.0), nie ohne
+    assert l2.startswith("torch==2.8.0+cu128 --hash=sha256:039b9dcd") and "--require-hashes" in a2
     _bauwerkzeug_und_taleward(a3, l3, a4)
 
@@ -202,5 +203,5 @@ def test_quelle_reicht_die_anhaenge_der_freigabe_weiter():
 def test_ab_der_pflichtfassung_nur_mit_liste(monkeypatch):
     """Ab PYTORCH_LISTE_PFLICHT_AB ohne unterschriebene Liste keine Installation – auch nicht, wenn ein Server eine
-    solche Fassung nennt. Ältere Fassungen (ohne Liste) gehen wie bisher, mit Hinweis im Protokoll."""
+    solche Fassung nennt. Ältere Fassungen (ohne Liste) nur mit den eingebauten Prüfsummen."""
     from taleward_worker import motor
 
@@ -223,2 +224,15 @@ def test_ab_der_pflichtfassung_nur_mit_liste(monkeypatch):
     assert inst.phase == "fehler" and "fehlt die unterschriebene Liste" in inst.fehlertext
     assert not any("--torch-backend" in a for a in aufrufe)  # nichts von PyTorch geladen
+
+
+def test_eingebaute_liste_passt_nur_zu_torch_280(monkeypatch):
+    """Ältere Fassung ohne eigene Liste: nur mit den eingebauten Prüfsummen; nennt ihre uv.lock ein anderes torch,
+    wird PyTorch nicht installiert."""
+    from taleward_worker import motor
+
+    liste = motor.pytorch_liste_lesen(motor.EINGEBAUTE_PYTORCH_LISTE)
+    assert {(v, p) for v, p, _ in liste} == {(v, p) for v in ("cu128", "cpu") for p in ("torch", "torchaudio", "torchvision")}
+    with pytest.raises(motor.MotorFehler):
+        motor.pytorch_mit_pruefsummen("torch==2.9.0\n", liste, "cu128")
+    zeile = motor.pytorch_mit_pruefsummen("torch==2.8.0 ; sys_platform == 'win32'\n", liste, "cpu")
+    assert zeile.startswith("torch==2.8.0+cpu ") and zeile.count("--hash=sha256:") == 5
