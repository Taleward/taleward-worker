From f30bedbab5a5f404f88844f18e166bbbf5c071d8 Mon Sep 17 00:00:00 2001
From: "Tinkerworks (Benjamin)"
 <121437138+Tinkerworkss@users.noreply.github.com>
Date: Wed, 21 Oct 2026 22:10:06 +0200
Subject: [PATCH] Worker 0.3.22
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Taleward Desktop: Die App im Rahmen kann bei gesperrtem Mikrofon die Windows-Seite dafür öffnen lassen.
Absprache nur über postMessage mit genau dem App-Rahmen (hello, desktop, mic-settings), geöffnet wird nur
ms-settings:privacy-microphone, höchstens einmal je 2 s.
---
 pyproject.toml                 |  2 +-
 taleward_worker/__init__.py    |  2 +-
 taleward_worker/oberflaeche.py |  9 +++++++++
 taleward_worker/ui/desktop.js  | 20 ++++++++++++++++++++
 tests/test_worker_0322.py      | 28 ++++++++++++++++++++++++++++
 uv.lock                        |  2 +-
 6 files changed, 60 insertions(+), 3 deletions(-)
 create mode 100644 tests/test_worker_0322.py

diff --git a/pyproject.toml b/pyproject.toml
index 778c87a..435dc42 100644
--- a/pyproject.toml
+++ b/pyproject.toml
@@ -1,5 +1,5 @@
 [project]
 name = "taleward-worker"
-version = "0.3.21"
+version = "0.3.22"
 description = "Taleward Worker – verarbeitet Aufnahmen für einen Taleward-Server auf dem eigenen PC mit Grafikkarte"
 license = "AGPL-3.0-only"
diff --git a/taleward_worker/__init__.py b/taleward_worker/__init__.py
index a20e994..520e619 100644
--- a/taleward_worker/__init__.py
+++ b/taleward_worker/__init__.py
@@ -4,5 +4,5 @@ Die App selbst ist klein. Das KI-Paket (Taleward-Server mit WhisperX, einige GB)
 passender Fassung zum verbundenen Server und startet es als Unterprozess („chronik worker --app“).
 """
-VERSION = "0.3.21"
+VERSION = "0.3.22"
 REPO = "Taleward/taleward-server"        # Server-Code = KI-Paket (engine-requirements.txt, Tags v…)
 APP_REPO = "Taleward/taleward-worker"   # diese App
diff --git a/taleward_worker/oberflaeche.py b/taleward_worker/oberflaeche.py
index fae82a6..1b158fd 100644
--- a/taleward_worker/oberflaeche.py
+++ b/taleward_worker/oberflaeche.py
@@ -434,4 +434,13 @@ class Api:
             subprocess.Popen(["xdg-open", ziel], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
 
+    def mikrofon_einstellungen(self) -> None:
+        """Nur die Windows-Seite „Datenschutz → Mikrofon“ (für die App im Rahmen, wenn Windows das Mikrofon sperrt).
+        Höchstens einmal je 2 s."""
+        jetzt = time.monotonic()
+        if sys.platform != "win32" or jetzt - getattr(self, "_mic_zuletzt", -10.0) < 2:
+            return
+        self._mic_zuletzt = jetzt
+        os.startfile("ms-settings:privacy-microphone")  # noqa: S606
+
     def link_oeffnen(self, url: str) -> None:
         """Nur https mit Host, ohne Zugangsdaten, Steuerzeichen und Backslashes (fenster.web_adresse)."""
diff --git a/taleward_worker/ui/desktop.js b/taleward_worker/ui/desktop.js
index a7436c0..be2f750 100644
--- a/taleward_worker/ui/desktop.js
+++ b/taleward_worker/ui/desktop.js
@@ -128,4 +128,24 @@
     if (!titel && !f.getAttribute("src")) f.src = APP + appZiel;
   }
+  // Absprache mit der App im Rahmen (nur postMessage): Die App meldet sich mit „hello“, die Oberfläche sagt, was sie
+  // anbietet. „mic-settings“ öffnet genau die Windows-Seite für das Mikrofon – ohne einen Wert aus der Nachricht.
+  const APP_HERKUNFT = "http://localhost:8000";
+  let micZuletzt = 0;
+  function appBegruessen() {
+    const f = $("#rahmen-app");
+    if (f.contentWindow) f.contentWindow.postMessage({ taleward: "desktop", can: ["mic-settings"] }, APP_HERKUNFT);
+  }
+  window.addEventListener("message", (e) => {
+    const f = $("#rahmen-app");
+    if (e.origin !== APP_HERKUNFT || !f || e.source !== f.contentWindow) return;
+    const d = e.data;
+    if (!d || typeof d !== "object" || typeof d.taleward !== "string") return;
+    if (d.taleward === "hello") appBegruessen();
+    else if (d.taleward === "mic-settings" && Date.now() - micZuletzt > 2000) {
+      micZuletzt = Date.now();
+      if (api) api.mikrofon_einstellungen();
+    }
+  });
+  $("#rahmen-app").addEventListener("load", appBegruessen);
   // Verwaltung im Rahmen erst, wenn der Server läuft und neu genug ist (ab 0.4.112 darf die Oberfläche sie einbetten) –
   // sonst zeigt WebView2 nur „Verbindung verweigert“. Bis dahin ein Hinweis mit Update und dem Weg über den Browser.
diff --git a/tests/test_worker_0322.py b/tests/test_worker_0322.py
new file mode 100644
index 0000000..bfc0567
--- /dev/null
+++ b/tests/test_worker_0322.py
@@ -0,0 +1,28 @@
+"""Worker 0.3.22: „Einstellungen öffnen“ bei gesperrtem Mikrofon – Absprache mit der App im Rahmen per postMessage."""
+from pathlib import Path
+
+UI = Path(__file__).resolve().parent.parent / "taleward_worker" / "ui"
+
+
+def test_mikrofon_einstellungen_nur_feste_seite(monkeypatch):
+    """Worker 0.3.22: Die App im Rahmen kann bitten, die Windows-Seite fürs Mikrofon zu öffnen – nur diese, gedrosselt,
+    nur auf Nachrichten genau vom App-Rahmen."""
+    import os
+    import sys
+
+    from taleward_worker import oberflaeche
+
+    geoeffnet = []
+    monkeypatch.setattr(sys, "platform", "win32")
+    monkeypatch.setattr(os, "startfile", lambda z: geoeffnet.append(z), raising=False)
+    api = oberflaeche.Api.__new__(oberflaeche.Api)
+    api.mikrofon_einstellungen()
+    api.mikrofon_einstellungen()  # gleich danach: gedrosselt
+    assert geoeffnet == ["ms-settings:privacy-microphone"]
+    js = (UI / "desktop.js").read_text(encoding="utf-8")
+    block = js[js.index('window.addEventListener("message"'):]
+    block = block[:block.index("});") + 3]
+    assert 'e.origin !== APP_HERKUNFT' in block and "e.source !== f.contentWindow" in block
+    assert 'api.mikrofon_einstellungen()' in block and "d.url" not in block
+    assert 'postMessage({ taleward: "desktop", can: ["mic-settings"] }, APP_HERKUNFT)' in js
+    assert 'const APP_HERKUNFT = "http://localhost:8000";' in js
