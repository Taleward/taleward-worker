             "ollama": a.ollama_stand(),
-            "taleward": {**a.server.fuer_oberflaeche(), "netz": a.netz} if a.e.einzelplatz else None,
+            "taleward": {**a.server.fuer_oberflaeche(), "netz": a.netz, "update": a.ep_update.fuer_oberflaeche()}
