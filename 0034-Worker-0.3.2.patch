     def taleward_neu_starten(self) -> None:
-        threading.Thread(target=self._app.server_neu_starten, daemon=True).start()
+        if not self._app.ep_update.laeuft():
+            threading.Thread(target=self._app.server_neu_starten, daemon=True).start()
+
+    def taleward_aktualisieren(self) -> dict:
