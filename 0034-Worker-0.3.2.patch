+    $("#taleward-text").textContent = imUpdate && upd.phase !== "vorbereiten" ? t("tw_upd_" + upd.phase, werte)
+      : art === "fehler" ? t("tw_f_" + (z.code || "startet_nicht"))
       : art === "laeuft" && tw.appFehlt ? t("tw_app_fehlt")
       : art === "laeuft" && !tw.app ? t("tw_app_laedt")
@@ -242,5 +246,15 @@
