     const tw = S.taleward || {}, z = tw.zustand || {}, art = z.art || "gestoppt";
-    $("#taleward-titel").textContent = t("tw_" + art);
-    $("#taleward-text").textContent = art === "fehler" ? t("tw_f_" + (z.code || "startet_nicht"))
