+    const um = $("#taleward-update");
+    const hinweis_upd = upd.phase === "vorbereiten" ? t("tw_upd_vorbereiten", werte)
+      : upd.phase === "zurueckgenommen" ? t("tw_upd_zurueckgenommen", werte)
+      : upd.phase === "fehler" ? t("tw_upd_fehler", werte)
