From 13573a067aa469c8888edeb814592b96a888348d Mon Sep 17 00:00:00 2001
From: "Tinkerworks (Benjamin)"
 <121437138+Tinkerworkss@users.noreply.github.com>
Date: Wed, 14 Oct 2026 20:40:37 +0200
Subject: [PATCH 34/34] Worker 0.3.2
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

„Alles auf diesem PC“ aktualisiert sich selbst auf die neueste
freigegebene Fassung: nur wenn gerade nichts läuft, mit Sicherung vorher,
Prüfung danach und Rückweg auf die alte Fassung samt Daten. Anzeige und
„Jetzt aktualisieren“ in der Taleward-Karte.
---
 pyproject.toml                 |  2 +-
 taleward_worker/__init__.py    |  2 +-
 taleward_worker/oberflaeche.py | 50 +++++++++++++++++++++++++++-------
 taleward_worker/ui/app.js      | 25 +++++++++++++++--
 taleward_worker/ui/index.html  |  2 ++
 taleward_worker/ui/texte.js    | 28 +++++++++++++++++++
 uv.lock                        |  2 +-
 7 files changed, 95 insertions(+), 16 deletions(-)

diff --git a/pyproject.toml b/pyproject.toml
index 28cd9ed..243f102 100644
--- a/pyproject.toml
+++ b/pyproject.toml
@@ -1,5 +1,5 @@
 [project]
 name = "taleward-worker"
-version = "0.3.1"
+version = "0.3.2"
 description = "Taleward Worker – verarbeitet Aufnahmen für einen Taleward-Server auf dem eigenen PC mit Grafikkarte"
 license = "AGPL-3.0-only"
diff --git a/taleward_worker/__init__.py b/taleward_worker/__init__.py
index 4548c41..9692447 100644
--- a/taleward_worker/__init__.py
+++ b/taleward_worker/__init__.py
@@ -4,5 +4,5 @@ Die App selbst ist klein. Das KI-Paket (Taleward-Server mit WhisperX, einige GB)
 passender Fassung zum verbundenen Server und startet es als Unterprozess („chronik worker --app“).
 """
-VERSION = "0.3.1"
+VERSION = "0.3.2"
