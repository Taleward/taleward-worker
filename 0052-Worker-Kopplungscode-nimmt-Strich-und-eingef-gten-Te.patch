+    const v = roh.toUpperCase().replace(/[^A-Z0-9]/g, "").slice(0, 8);
+    if (v.length > 4) return v.slice(0, 4) + "-" + v.slice(4);
+    return v.length === 4 && /-\s*$/.test(roh) ? v + "-" : v;
+  }
