+      titel = t("st_modell_laedt");
+      text = t("st_modell_laedt_text", { wann: wann(z.neuerVersuch) });
     } else if (art === "fehler" && z.code === "modell") {
       titel = t(einzelplatz() ? "st_modell_hier" : "st_modell");
@@ -367,5 +378,7 @@
