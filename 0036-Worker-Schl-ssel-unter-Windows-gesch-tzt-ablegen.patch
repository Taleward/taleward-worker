--- /dev/null
+++ b/taleward_worker/geschuetzt.py
@@ -0,0 +1,77 @@
+"""Geheimnisse unter Windows mit dem Windows-Datenschutz (DPAPI, Benutzerbereich) ablegen.
+
+Betrifft den Schlüssel, mit dem dieser Worker beim Server angemeldet ist (in den Einstellungen), und den Schlüssel
+des Workers von „Alles auf diesem PC“ (schreibt der Server ab 0.4.100 geschützt, wenn das Programm es ihm sagt).
+Lesen kann beides nur derselbe Windows-Nutzer auf demselben PC. Text-Form: `dpapi:<Base64>`; Klartext aus älteren
+Fassungen wird weiter gelesen und beim nächsten Speichern geschützt. Außerhalb von Windows ändert sich nichts.
+"""
+from __future__ import annotations
+
+import base64
+import logging
+import sys
+
+log = logging.getLogger("taleward_worker")
+PRAEFIX = "dpapi:"
+_ENTROPIE = b"Taleward"
+
+
+def verfuegbar() -> bool:
+    return sys.platform == "win32"
+
+
+def schuetzen(daten: bytes) -> bytes:
+    return _aufruf(daten, schuetzen=True)
+
+
+def oeffnen(daten: bytes) -> bytes:
+    return _aufruf(daten, schuetzen=False)
+
+
+def _aufruf(daten: bytes, schuetzen: bool) -> bytes:  # pragma: no cover – nur unter Windows
+    import ctypes
+    from ctypes import wintypes
+
+    class Blob(ctypes.Structure):
+        _fields_ = [("cbData", wintypes.DWORD), ("pbData", ctypes.POINTER(ctypes.c_char))]
+
+    puffer = []  # bis zum Ende des Aufrufs festhalten, sonst zeigte der Blob ins Leere
+
+    def blob(b: bytes) -> Blob:
+        puffer.append(ctypes.create_string_buffer(b, len(b)))
+        return Blob(len(b), ctypes.cast(puffer[-1], ctypes.POINTER(ctypes.c_char)))
+
+    crypt32, kernel32 = ctypes.windll.crypt32, ctypes.windll.kernel32  # type: ignore[attr-defined]
+    ein, entropie, aus = blob(daten), blob(_ENTROPIE), Blob()
+    funktion = crypt32.CryptProtectData if schuetzen else crypt32.CryptUnprotectData
+    # CRYPTPROTECT_UI_FORBIDDEN – nie eine Rückfrage anzeigen
+    if not funktion(ctypes.byref(ein), None, ctypes.byref(entropie), None, None, 0x1, ctypes.byref(aus)):
+        raise OSError(ctypes.GetLastError() or "DPAPI")  # type: ignore[attr-defined]
+    try:
+        return ctypes.string_at(aus.pbData, aus.cbData)
+    finally:
+        kernel32.LocalFree(aus.pbData)
+
+
+def text_schuetzen(wert: str) -> str:
+    if not verfuegbar() or not wert or wert.startswith(PRAEFIX):
+        return wert
+    try:
+        return PRAEFIX + base64.b64encode(schuetzen(wert.encode("utf-8"))).decode("ascii")
+    except (OSError, AttributeError, ValueError):
+        # Lieber weiter wie bisher (nur für den Nutzer lesbar) als gar nicht speichern können
+        log.warning("Windows-Datenschutz nicht verfügbar – Wert ungeschützt abgelegt")
+        return wert
+
+
+def text_oeffnen(wert: str) -> str:
+    """Klartext unverändert; geschützt, aber hier nicht zu öffnen (anderer PC oder Nutzer) → leer."""
+    if not wert or not wert.startswith(PRAEFIX):
+        return wert
+    if not verfuegbar():
+        return ""
+    try:
+        return oeffnen(base64.b64decode(wert[len(PRAEFIX):])).decode("utf-8")
+    except (OSError, ValueError):
+        log.warning("Ein geschützter Schlüssel lässt sich auf diesem PC nicht öffnen")
+        return ""
diff --git a/tests/test_geschuetzt.py b/tests/test_geschuetzt.py
new file mode 100644
index 0000000..6f6ea7b
--- /dev/null
+++ b/tests/test_geschuetzt.py
@@ -0,0 +1,68 @@
+"""Schlüssel unter Windows mit dem Windows-Datenschutz (ab Worker 0.3.4)."""
+import json
+
+import pytest
+
+
+@pytest.fixture()
+def windows(monkeypatch):
+    from taleward_worker import geschuetzt
+
+    monkeypatch.setattr(geschuetzt, "verfuegbar", lambda: True)
+    monkeypatch.setattr(geschuetzt, "schuetzen", lambda b: b"DIESER" + b[::-1])
+
+    def oeffnen(b):
+        if not b.startswith(b"DIESER"):
+            raise OSError("anderer PC")
+        return b[6:][::-1]
+    monkeypatch.setattr(geschuetzt, "oeffnen", oeffnen)
+    return geschuetzt
+
+
+def test_kopplungsschluessel_geschuetzt(windows):
+    from taleward_worker import pfade
+    from taleward_worker.einstellungen import Einstellungen
+
+    e = Einstellungen(server="https://beispiel.invalid", token="wk.1.geheim")
+    e.speichern()
+    roh = json.loads(pfade.einstellungen().read_text(encoding="utf-8"))
+    assert roh["token"].startswith("dpapi:") and "geheim" not in pfade.einstellungen().read_text(encoding="utf-8")
+    assert Einstellungen.laden().token == "wk.1.geheim" and e.token == "wk.1.geheim"
+    # aus einer älteren Fassung (Klartext) weiter lesbar
+    roh["token"] = "wk.2.alt"
+    pfade.einstellungen().write_text(json.dumps(roh), encoding="utf-8")
+    assert Einstellungen.laden().token == "wk.2.alt"
+    # von einem anderen PC kopiert: nicht lesbar → nicht gekoppelt
+    roh["token"] = "dpapi:QU5ERVJFUg=="
+    pfade.einstellungen().write_text(json.dumps(roh), encoding="utf-8")
+    assert Einstellungen.laden().token == "" and not Einstellungen.laden().gekoppelt
+
+
+def test_ohne_windows_bleibt_der_schluessel_wie_er_ist():
+    from taleward_worker import pfade
+    from taleward_worker.einstellungen import Einstellungen
+
+    Einstellungen(server="https://beispiel.invalid", token="wk.1.x").speichern()
+    assert json.loads(pfade.einstellungen().read_text(encoding="utf-8"))["token"] == "wk.1.x"
+
+
+def test_worker_schluessel_von_taleward_geschuetzt(windows):
+    from taleward_worker import einzelplatz, pfade
+
+    d = einzelplatz.ServerDienst()
+    assert d.umgebung()["EINZELPLATZ_WORKER_GESCHUETZT"] == "true"
+    pfade.worker_schluessel().write_text(windows.text_schuetzen("wk.7.frisch") + "\n", encoding="utf-8")
+    assert d.worker_token() == "wk.7.frisch"
+    pfade.worker_schluessel().write_text("wk.8.klartext\n", encoding="utf-8")  # Server vor 0.4.100
+    assert d.worker_token() == "wk.8.klartext"
+    pfade.worker_schluessel().write_text("dpapi:QU5ERVJFUg==\n", encoding="utf-8")
+    assert d.worker_token() is None
+    assert einzelplatz.MINDEST_SERVER == "0.4.100"
+
+
+def test_ohne_funktionierenden_datenschutz_wird_trotzdem_gespeichert(windows, monkeypatch):
+    from taleward_worker.einstellungen import Einstellungen
+
+    monkeypatch.setattr(windows, "schuetzen", lambda b: (_ for _ in ()).throw(OSError("geht nicht")))
+    Einstellungen(server="https://beispiel.invalid", token="wk.1.x").speichern()
+    assert Einstellungen.laden().token == "wk.1.x"
