diff --git a/taleward_worker/serverupdate.py b/taleward_worker/serverupdate.py
index ce0331d..a38dd8e 100644
--- a/taleward_worker/serverupdate.py
+++ b/taleward_worker/serverupdate.py
@@ -38,4 +38,12 @@ LAEUFT = ("vorbereiten", "sichern", "tauschen", "starten", "pruefen", "zurueck")
 
 
+def grund_kurz(inst) -> str:
+    """Letzte aussagekräftige Zeile des Fehlers fürs Protokoll (eine Zeile, höchstens 200 Zeichen) – sonst sieht man
+    nur „installation“ und muss die Hilfe-Datei anfordern."""
+    zeilen = [z.strip() for z in str(getattr(inst, "fehlertext", "") or "").splitlines() if z.strip()]
+    zeilen = [z for z in zeilen if not z.startswith("$ ")]
+    return f" ({zeilen[-1][:200]})" if zeilen else ""
+
+
 class ServerUpdate:
     def __init__(self, app):
@@ -196,5 +204,6 @@ class ServerUpdate:
                 self._protokoll(f"Update auf {self.neu} verschoben: {getattr(inst, 'fehlertext', '')} – später noch einmal")
             else:
-                self._protokoll(f"Update auf {self.neu} vorbereitet nicht: {inst.fehler} – Taleward läuft unverändert")
+                self._protokoll(f"Update auf {self.neu} vorbereitet nicht: {inst.fehler}{grund_kurz(inst)} – Taleward "
+                                "läuft unverändert")
             return
         if gesichert:
diff --git a/tests/test_worker_0319.py b/tests/test_worker_0319.py
new file mode 100644
index 0000000..a2fa42e
--- /dev/null
+++ b/tests/test_worker_0319.py
@@ -0,0 +1,28 @@
+"""Worker 0.3.19: Paketlisten werden außerhalb des uv-Zwischenspeichers erzeugt (neuere uv lehnen ein Projekt im
+Zwischenspeicher ab) – sonst scheitert jedes Update des KI-Pakets nach wenigen Sekunden. Der Grund steht jetzt mit im
+Protokoll."""
+import types
+
+from taleward_worker import motor, pfade, serverupdate
+
+
+def test_listen_ausserhalb_des_zwischenspeichers(tmp_path, monkeypatch):
+    monkeypatch.setenv("TALEWARD_WORKER_HOME", str(tmp_path))
+    gesehen = {}
+
+    def pruefsummen(q, umgebung, ordner):
+        gesehen["ordner"], gesehen["cache"] = ordner, umgebung["UV_CACHE_DIR"]
+        return "", ""
+
+    monkeypatch.setattr(motor, "pruefsummen", pruefsummen)
+    inst = motor.Installation("0.4.116", testmodus=True, backend="cpu")
+    inst._listen({"ref": "v0.4.116"})
+    cache = pfade.basis() / "cache"
+    assert str(cache) == gesehen["cache"]
+    assert cache not in gesehen["ordner"].parents and gesehen["ordner"] != cache
+
+
+def test_grund_steht_im_protokoll():
+    inst = types.SimpleNamespace(fehlertext="$ uv export\nerror: The project directory `.` is inside the cache directory")
+    assert serverupdate.grund_kurz(inst) == " (error: The project directory `.` is inside the cache directory)"
+    assert serverupdate.grund_kurz(types.SimpleNamespace(fehlertext="")) == ""
